{
  "info": {
    "name": "Foundry - Campus Lost and Found API",
    "description": "API testing evidence for the Sai University Web Technology project. Run 'Auth / Login (student)' and 'Auth / Login (admin)' first so the tokens are saved into collection variables. All other requests then work in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "claimId",
      "value": ""
    },
    {
      "key": "priyaToken",
      "value": ""
    },
    {
      "key": "regEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('service is foundry-api', () => pm.expect(pm.response.json().service).to.eql('foundry-api'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// A new email each run so repeated runs still return 201",
                  "const unique = 'postman' + Date.now() + '@saiuniversity.edu.in';",
                  "pm.collectionVariables.set('regEmail', unique);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('returns a token', () => pm.expect(pm.response.json()).to.have.property('token'));",
                  "pm.test('does not leak password', () => pm.expect(pm.response.json().user).to.not.have.property('password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"{{regEmail}}\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Register duplicate email (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"{{regEmail}}\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
