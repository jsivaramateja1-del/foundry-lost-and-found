/**
 * Reading and authorising a points backup for restore.
 *
 * Deliberately free of any database import: every check here runs before a
 * connection is opened, so a malformed or unauthorised file fails fast and
 * cannot touch the database.
 */
const fs = require('fs');

const RESTORE_FORMAT = 'foundry-points-backup/2';

class RestoreError extends Error {
  constructor(code, message) {
    super(message);
    this.name = 'RestoreError';
    this.code = code;
  }
}

/**
 * @param {object} input
 * @param {string} input.file    path to a backup
 * @param {boolean} [input.force] allow a restore whose provenance is unknown
 * @returns {{file:string, accounts:Array, legacy:boolean, flags:object|null, createdAt:string|null}}
 * @throws {RestoreError}
 */
const prepareRestore = ({ file, force = false } = {}) => {
  if (!file || String(file).startsWith('--')) {
    throw new RestoreError('NO_FILE', '--restore needs the path of a backup file.');
  }
  if (!fs.existsSync(file)) {
    throw new RestoreError('MISSING', `Backup file not found: ${file}`);
  }

  let raw;
  try {
    raw = JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch (err) {
    throw new RestoreError('BAD_JSON', `${file} is not valid JSON: ${err.message}`);
  }

  const isEnvelope = raw && !Array.isArray(raw) && Array.isArray(raw.accounts);
  const accounts = isEnvelope ? raw.accounts : raw;

  if (!Array.isArray(accounts)) {
    throw new RestoreError('BAD_SHAPE', 'That file does not look like a points backup.');
  }

  const seenIds = new Set();
  const bad = accounts.find((a) => {
    if (!a || typeof a.id !== 'string' || !/^[a-fA-F0-9]{24}$/.test(a.id)
        || !Number.isSafeInteger(a.points) || a.points < 0
        || !Number.isSafeInteger(a.returns) || a.returns < 0
        || seenIds.has(a.id.toLowerCase())) return true;
    seenIds.add(a.id.toLowerCase());
    return false;
  });
  if (bad) {
    throw new RestoreError(
      'BAD_ACCOUNT',
      'Every account must have a unique 24-character MongoDB id and non-negative whole-number points and returns values.'
    );
  }

  const flags = (isEnvelope && raw.flags) ? raw.flags : null;
  const legacy = !isEnvelope;

  // Fail closed. A v1 backup has no metadata, so there is no way to know
  // whether the run that produced it also changed ledger state; assuming
  // --complete-pending was off would be a guess, and the wrong guess leaves
  // the ledger claiming awards that the restored balance no longer reflects.
  if (legacy && !force) {
    throw new RestoreError(
      'NEEDS_FORCE',
      'This is a v1 backup with no metadata, so the flags used by the original run cannot be verified.\n'
      + 'It may have been produced by a run that also changed ledger state, which a balance restore cannot undo.\n'
      + 'This restores balances only — it is not a full rollback. Re-run with --force to accept that.'
    );
  }

  if (flags && flags.completePending && !force) {
    throw new RestoreError(
      'NEEDS_FORCE',
      'This backup was taken with --complete-pending, which changed ledger state that --restore cannot reverse.\n'
      + 'Restoring balances alone leaves the ledger claiming those awards were credited.\n'
      + 'Re-run with --force to accept that this is a balance restore, not a full rollback.'
    );
  }

  return {
    file,
    accounts,
    legacy,
    flags,
    createdAt: isEnvelope ? raw.createdAt || null : null,
    host: isEnvelope ? raw.host || null : null,
    database: isEnvelope ? raw.database || null : null,
    format: isEnvelope ? raw.format || RESTORE_FORMAT : 'v1'
  };
};

/** The exact scope of a restore, for printing before anything is written. */
const describeRestore = (plan) => {
  const lines = [];
  lines.push(`Backup:   ${plan.file}`);
  if (plan.legacy) {
    lines.push('Format:   v1 (no metadata) — the original run\'s flags cannot be verified.');
  } else {
    lines.push(`Taken:    ${plan.createdAt}  (host ${plan.host}, database ${plan.database})`);
    lines.push(`Run with: apply=${Boolean(plan.flags && plan.flags.apply)} `
      + `allowDecrease=${Boolean(plan.flags && plan.flags.allowDecrease)} `
      + `completePending=${Boolean(plan.flags && plan.flags.completePending)}`);
  }
  lines.push('');
  lines.push('What --restore WILL do:');
  lines.push(`  - set points and returns for ${plan.accounts.length} account(s) to the values in this file.`);
  lines.push('');
  lines.push('What --restore will NOT do:');
  lines.push('  - it does not delete, re-open or otherwise change any PointEvent.');
  lines.push('  - it does not remove anything from User.creditedEvents.');
  if (plan.legacy) {
    lines.push('  - it cannot tell whether the original run completed any pending events.');
  }
  lines.push('');
  lines.push('Before you continue:');
  lines.push('  - any points earned AFTER this backup will be overwritten by the values here.');
  lines.push('  - if events were completed after the backup, restoring balances makes the ledger');
  lines.push('    disagree with the totals, and a later reconcile --apply will top them back up.');
  lines.push('    That is expected, not a bug.');
  return lines.join('\n');
};

module.exports = { prepareRestore, describeRestore, RestoreError, RESTORE_FORMAT };
