{
  "name": "foundry-backend",
  "version": "1.0.0",
  "description": "Campus Lost and Found Portal - Sai University Web Technology Project",
  "main": "server.v2.js",
  "scripts": {
    "start": "node server.v2.js",
    "start:pg": "node server.v2.js",
    "dev": "nodemon server.v2.js",
    "dev:pg": "nodemon server.v2.js",
    "db:init": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "create-admin": "node scripts/create-admin-pg.js",
    "test": "npm run test:auth-v2 && npm run test:connection",
    "test:auth-v2": "node test/auth-v2.test.js",
    "test:pg": "node test/pg.integration.test.js",
    "test:boot-v2": "node test/boot-v2.test.js",
    "seed:browser": "node test/browser/seed.js",
    "test:browser": "playwright test",
    "test:deploy": "node test/deploy.test.js",
    "seed:campus": "node scripts/seed-campus-pg.js",
    "reconcile:points": "node scripts/reconcile-points-pg.js",
    "test:connection": "node test/connection.test.js",
    "seed:demo": "node scripts/seed-demo-items.js",
    "seed:users": "node scripts/make-test-users.js",
    "test:all": "npm run test:auth-v2 && npm run test:connection && npm run test:pg && npm run test:boot-v2 && npm run test:deploy"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "supertest": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  },
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  }
}