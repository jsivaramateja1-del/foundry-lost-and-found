# Foundry backend — PostgreSQL (Supabase) configuration.
#
# Copy this file to .env and fill in real values. Never commit .env.
# The server refuses to start if JWT_SECRET or DATABASE_URL is missing.

# ---------------------------------------------------------------------------
# Database — REQUIRED
# ---------------------------------------------------------------------------
# Use the Supabase SHARED POOLER string, not the direct connection.
#
#   Direct  (db.<ref>.supabase.co:5432)  -> IPv6 only on the free plan. Render
#                                          has no outbound IPv6, so it fails
#                                          with ENETUNREACH. Do not use it here.
#   Pooler  (aws-<n>-<region>.pooler.supabase.com:6543 or :5432) -> IPv4 always.
#
# The pooler username carries the project ref: postgres.<PROJECT_REF>
# Percent-encode reserved characters in the password: @ -> %40, # -> %23
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# TLS — choose ONE. The pooler presents a chain signed by Supabase's own CA,
# which Node does not trust by default.
# ---------------------------------------------------------------------------
# Preferred: point at Supabase's prod-ca-2021.crt (Settings -> Database -> SSL
# Configuration). On Render, upload it as a Secret File and reference that path.
# PG_CA_CERT_PATH=/etc/secrets/prod-ca-2021.crt
#
# Quick but weaker: accept the chain without verifying it. The server logs a
# warning on every start while this is set.
# PG_SSL_NO_VERIFY=true

# ---------------------------------------------------------------------------
# Application — REQUIRED
# ---------------------------------------------------------------------------
# Signing key for session tokens. Use a long random string. There is no
# fallback: the server will not start without it.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Absolute base URL used to build every link in outgoing email. Without this,
# verification and password-reset links point at localhost and are dead.
APP_URL=https://foundry-lost-and-found.onrender.com

# ---------------------------------------------------------------------------
# Email — REQUIRED for registration
# ---------------------------------------------------------------------------
# Registration creates an unverified account and emails a verification link.
# Without these the account is created but cannot be activated.
# The API key must start with xkeysib- (an SMTP key starting xsmtpsib- will be
# rejected). In Brevo the key needs "Transactional email: All" to send.
BREVO_API_KEY=
BREVO_SENDER=
BREVO_SENDER_NAME=Foundry

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=10000
# Comma-separated allowed origins in production. Empty means deny all.
CLIENT_ORIGIN=https://foundry-lost-and-found.onrender.com

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Connection pool size PER PROCESS. Keep it small on the free tier: several
# workers each open their own pool against the same pooler limit.
# PG_POOL_MAX=10
