# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to GitHub.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string. Replace user, password and cluster name.
# Keep the /foundry database name at the end.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/foundry?retryWrites=true&w=majority

# Long random string used to sign login tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
