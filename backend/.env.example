# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to GitHub.

PORT=5000
NODE_ENV=development

# MongoDB connection string. Replace user, password and cluster name.
# Keep the /foundry database name at the end.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/foundry?retryWrites=true&w=majority

# Long random string used to sign login tokens. The server refuses to start
# without it. There is no default and no fallback.
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins (CORS).
# Same-origin requests are always allowed, so this is only needed when the
# frontend is hosted somewhere else.
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# The ONLY student email domain allowed to register. Case-insensitive and
# matched exactly — subdomains and look-alike domains are refused.
# Override only if the university changes the domain.
ALLOWED_EMAIL_DOMAIN=scds.saiuniversity.edu.in

# Email verification is OFF by default. When "enabled" the server REQUIRES the
# SMTP settings below and refuses to start without them, so a verification
# email is never silently skipped. Turn it on once you have an SMTP account.
EMAIL_VERIFICATION=disabled
APP_URL=http://localhost:5000
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=Foundry <no-reply@saiuniversity.edu.in>

# Used ONLY by `npm run create-admin`, to create the first administrator.
# These are read from your shell or from this file; they are never hardcoded
# in the source. Choose your own strong password (8 characters or more).
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@saiuniversity.edu.in
ADMIN_PASSWORD=choose_a_strong_password
